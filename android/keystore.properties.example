# Copy to keystore.properties (gitignored) and fill in with your own values.
# The password is yours — it is not stored anywhere in this repo.
#
# Create the keystore first:
#
#   keytool -genkeypair -v \
#     -keystore ~/keys/okayweather-upload.jks \
#     -alias okayweather-upload \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile may be an absolute path (recommended — keeps the key out of the
# repo entirely) or a path relative to this android/ directory.

storeFile=/Users/you/keys/okayweather-upload.jks
storePassword=
keyAlias=okayweather-upload
keyPassword=
